{
  "name": "openteam",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted control plane for tracking team work and coordinating agent runs.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check && vp run -r typecheck",
    "dev": "vp run server#dev & vp run web#dev",
    "ready": "bun run check && bun run test && bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "catalog": {
    "@effect/platform-bun": "4.1.5",
    "@effect/sql-sqlite-bun": "4.1.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "oxc-parser": "0.157.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  }
}
